# NBTI API Keys
# Copy this file to .env and fill in your API keys
# These override config.json values at runtime

# Admin token for config write APIs (POST /api/config, /api/config/reset, /api/config/test-connection)
# and full GET /api/config. Clients must send header: X-Admin-Token
# Required by Docker / start.sh. Use a strong random value, not a placeholder.
# Development servers permit localhost admin requests when unset.
NBTI_ADMIN_TOKEN=

# LongCat
NBTI_API_KEY_LONGCAT=

# DeepSeek
NBTI_API_KEY_DEEPSEEK_V4_FLASH=

# Doubao (Volces Ark / ByteDance)
NBTI_API_KEY_DOUBAO=

# LM Studio (usually "lm-studio" for local)
NBTI_API_KEY_LM_STUDIO=lm-studio

